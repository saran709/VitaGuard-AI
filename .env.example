# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Never expose this key in client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web SDK Configuration (Client-side public identifiers)
# Copy this file to .env and fill in your Firebase project values.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: Set to "true" to connect Auth, Firestore, and Functions to the local Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATOR="false"
VITE_FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST="localhost:8080"
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST="localhost:5001"

# Optional Server-Side Notification Gateway Configuration (Disabled by default)
# Never expose SMS_GATEWAY_API_KEY in VITE_ client variables.
VITAGUARD_ENABLE_LIVE_SMS="false"
SMS_GATEWAY_API_KEY="YOUR_SERVER_SMS_GATEWAY_SECRET"
SMS_GATEWAY_ENDPOINT="https://api.example-sms-gateway.invalid/v1/messages"

# Wearable & Environmental Data Integration (Server-Side Proxies)
# Never expose wearable OAuth client secrets or third-party provider keys in VITE_ variables.
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEARABLE_OAUTH_CLIENT_ID="YOUR_WEARABLE_OAUTH_CLIENT_ID"
WEARABLE_OAUTH_CLIENT_SECRET="YOUR_SERVER_WEARABLE_OAUTH_SECRET"


